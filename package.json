{
  "name": "tickets-transfer-v2",
  "private": true,
  "description": "Plataforma de intercambio y reventa segura de entradas digitales - Tickets Transfer (TT)",
  "version": "2.0.0",
  "packageManager": "pnpm@9.15.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall-patches.cjs",
    "install:clean": "node -e \"const fs=require('fs');const t=Date.now();['node_modules','apps/api/node_modules','apps/web/node_modules','apps/admin/node_modules','apps/mobile/node_modules','packages/shared/node_modules'].forEach(d=>{if(fs.existsSync(d)){try{fs.renameSync(d,d+'.old.'+t);}catch(e){console.error('Renombrar falló:',d,e.message);}}});['package-lock.json','pnpm-lock.yaml'].forEach(f=>{if(fs.existsSync(f))fs.unlinkSync(f);});\" && npx --yes pnpm@9.15.5 install",
    "setup:pnpm": "node scripts/ensure-pnpm.mjs",
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=api",
    "dev:api:run": "cd apps/api && npx tsx watch src/index.ts",
    "dev:web": "npm run dev --workspace=web",
    "dev:web:run": "cd apps/web && npx vite",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:admin:run": "cd apps/admin && npx vite",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build:admin": "npm run build --workspace=admin",
    "db:generate": "cd apps/api && npx prisma generate",
    "db:migrate": "cd apps/api && npx prisma migrate deploy",
    "db:studio": "cd apps/api && npx prisma studio",
    "db:push": "cd apps/api && npx prisma db push"
  },
  "devDependencies": {
    "patch-package": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "nodeLinker": "hoisted",
    "overrides": {
      "react": "18.2.0"
    }
  }
}
