# Base de datos PostgreSQL (en producción usar URL de Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://usuario:password@localhost:5432/tickets_transfer"

# JWT (en producción generar secretos seguros: openssl rand -base64 32)
JWT_SECRET="cambiar-por-secreto-seguro"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto"

# Desarrollo: orígenes CORS. Producción (NODE_ENV=production) permite cualquier origen (app móvil).
CORS_ORIGIN_WEB="http://localhost:5173"
CORS_ORIGIN_ADMIN="http://localhost:5174"

# URL base de la API (para enlaces a uploads; en producción tu URL pública)
APP_URL="http://localhost:3001"

# Producción (lo fija el hosting)
# NODE_ENV=production
# PORT=3001
