# ===========================================
# Firebase (obligatorio)
# ===========================================
# Opción 1: Ruta al archivo JSON de cuenta de servicio
# Descargar desde Firebase Console → Configuración del proyecto → Cuentas de servicio
GOOGLE_APPLICATION_CREDENTIALS="./firebase-service-account.json"

# Opción 2: Contenido JSON como variable (útil en Vercel, Railway, etc.)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...",...}'

# Bucket de Storage para avatares, tickets, KYC, evidencia
# Bucket real de tu proyecto (ej: ticketstransfer-8bd76.firebasestorage.app)
# Si usás el placeholder "tu-proyecto.appspot.com", se infiere desde project_id del service account
FIREBASE_STORAGE_BUCKET="tu-proyecto.firebasestorage.app"

# Si Firebase billing falla (403/404): fallback automático a almacenamiento local.
# Para forzar local siempre: STORAGE_FALLBACK=local
# En Railway: Volume en /app/uploads, UPLOADS_PATH=/app/uploads. En Vercel: usar solo Firebase Storage (no local).

# ===========================================
# CORS y URL
# ===========================================
CORS_ORIGIN_WEB="http://localhost:5173"
CORS_ORIGIN_ADMIN="http://localhost:5174"
APP_URL="http://localhost:3001"
WEB_URL="http://localhost:5173"

# ===========================================
# Didit KYC (https://business.didit.me)
# ===========================================
DIDIT_API_KEY="tu-api-key-didit"
DIDIT_WEBHOOK_SECRET_KEY="tu-webhook-secret-didit"
DIDIT_WORKFLOW_ID="tu-workflow-id-didit"

# ===========================================
# Mercado Pago (Checkout Pro)
# ===========================================
# Access Token: Tus integraciones → Credenciales → Access Token (producción o prueba)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxx"

# Webhook secret: Tus integraciones → Webhooks → Configurar notificaciones → Clave secreta
# Obligatorio para validar que las notificaciones vienen de Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=""

# Email opcional para avisos de nuevas ventas (si no hay usuarios role=admin en Firestore)
# ADMIN_NOTIFICATION_EMAIL="admin@tudominio.com"

# ===========================================
# Email - Verificación de cuenta (Resend)
# ===========================================
# Plan gratuito: 100 emails/día. https://resend.com
# 1. Crear cuenta en https://resend.com
# 2. API Keys → Create API Key → copiar clave
# 3. Domains → verificar tu dominio (producción) o usar onboarding@resend.dev (solo pruebas)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# Remitente para códigos de verificación. OBLIGATORIO en producción con dominio verificado.
# Sin esto, Resend solo permite enviar a tu propio email (onboarding@resend.dev).
# EMAIL_FROM_VERIFICATION="Tickets Transfer <noreply@ticketstransfer.juanprogramador.com>"

# ===========================================
# SMS - Verificación de teléfono (Twilio)
# ===========================================
# Obligatorio en producción para enviar códigos reales por SMS.
# 1. Crear cuenta en https://www.twilio.com
# 2. Console → Account → copiar Account SID y Auth Token
# 3. Phone Numbers → Manage → Buy a number (o usar el de prueba)
# 4. El número debe estar en formato E.164, ej: +14155238886
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="tu-auth-token"
TWILIO_PHONE_NUMBER="+14155238886"

# ===========================================
# Cron externo (cron-job.org)
# ===========================================
# 1. Generá CRON_SECRET (mín. 16 caracteres aleatorios) y configurálo en Vercel → Environment Variables.
# CRON_SECRET="tu-clave-secreta-aleatoria"
#
# 2. En https://console.cron-job.org creá dos cron jobs (método GET, timezone Argentina si aplica):
#
# Job A — Liberar reservas de pago vencidas (cada 10 minutos)
#   URL:    https://ticketstransfer-api.vercel.app/api/cron/expire-payment-reservations
#   Schedule: */10 * * * *  (o "Every 10 minutes" en el asistente)
#   Headers:  Authorization = Bearer <CRON_SECRET>
#
# Job B — Reintentar transferencias fallidas al vendedor (cada hora)
#   URL:    https://ticketstransfer-api.vercel.app/api/cron/retry-failed-transfers
#   Schedule: 0 * * * *  (minuto 0 de cada hora)
#   Headers:  Authorization = Bearer <CRON_SECRET>
#
# En cron-job.org: Edit job → Advanced → Request method GET → Request headers → agregar Authorization.
# Respuesta esperada: JSON { "ok": true, ... }. Si falta CRON_SECRET en Vercel, la API responde 401.

# ===========================================
# Imagen de portada del evento (Gemini + fallbacks)
# ===========================================
# API key gratuita: https://aistudio.google.com/apikey
# Gemini solo si EVENT_IMAGE_USE_GEMINI=1 (cuota limitada; prioridad: ticketeras Ticketek/All Access).
GEMINI_API_KEY=""
# EVENT_IMAGE_USE_GEMINI=1
# La imagen se resuelve por eventName + eventDate + ticketera (sin URLs fijas por evento).

# Tiempo máximo (ms) para resolver imagen (en Vercel default 28000 si no se define)
# EVENT_IMAGE_TIMEOUT_MS=28000

# Logs detallados en consola (preview/store): EVENT_IMAGE_DEBUG=1
# EVENT_IMAGE_DEBUG=1

# Tamaño mínimo de imagen descargada en bytes (default 800)
# EVENT_IMAGE_MIN_BYTES=800

# Generación IA de respaldo vía Pollinations (1 para desactivar: EVENT_IMAGE_AI_GENERATION=0)
# EVENT_IMAGE_AI_GENERATION=0

# Producción
# NODE_ENV=production
# PORT=3001
