{
  "name": "mobile",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "npx react-native start",
    "start:reset": "npx react-native start --reset-cache",
    "android": "node -e \"const cp=require('child_process');try{cp.execSync('adb reverse tcp:8081 tcp:8081',{stdio:'ignore',shell:true});}catch{}cp.execSync('npx react-native run-android',{stdio:'inherit',shell:true});\"",
    "android:install": "node -e \"const cp=require('child_process');const gradlew=process.platform==='win32'?'gradlew.bat':'./gradlew';try{cp.execSync('adb reverse tcp:8081 tcp:8081',{stdio:'ignore',shell:true});}catch{}cp.execSync(`cd android && ${gradlew} --stop`,{stdio:'ignore',shell:true});cp.execSync(`cd android && ${gradlew} app:installDebug -PreactNativeDevServerPort=8081 --no-daemon`,{stdio:'inherit',shell:true});\"",
    "android:clean": "node -e \"const cp=require('child_process');const os=require('os');const fs=require('fs');const path=require('path');try{if(process.platform!=='win32'){cp.execSync('lsof -t -i :8081 | xargs kill',{stdio:'ignore',shell:true});}}catch{}try{fs.rmSync(path.join(os.homedir(),'.metro'),{recursive:true,force:true});}catch{}try{cp.execSync('adb reverse tcp:8081 tcp:8081',{stdio:'ignore',shell:true});}catch{}console.log('Listo. Ejecutá pnpm start:reset y luego pnpm android');\"",
    "ios": "npx react-native run-ios",
    "lint": "eslint .",
    "fix:android": "bash scripts/fix-android-build.sh",
    "postinstall": "node -e \"process.exit(0)\"",
    "apk:debug": "node -e \"const cp=require('child_process');const gradlew=process.platform==='win32'?'gradlew.bat':'./gradlew';cp.execSync(`cd android && ${gradlew} assembleDebug`,{stdio:'inherit',shell:true});\"",
    "apk:release": "node -e \"const cp=require('child_process');const gradlew=process.platform==='win32'?'gradlew.bat':'./gradlew';cp.execSync(`cd android && ${gradlew} assembleRelease --no-daemon`,{stdio:'inherit',shell:true,env:{...process.env,NODE_OPTIONS:'--max-old-space-size=4096'}});\"",
    "apk:release:clean": "node -e \"const os=require('os');const fs=require('fs');const path=require('path');['node_modules/.cache','android/app/build/generated'].forEach((p)=>{try{fs.rmSync(path.resolve(p),{recursive:true,force:true});}catch{}});try{fs.rmSync(path.join(os.homedir(),'.metro'),{recursive:true,force:true});}catch{}\" && pnpm apk:release",
    "apk:release:no-daemon": "node -e \"const cp=require('child_process');const gradlew=process.platform==='win32'?'gradlew.bat':'./gradlew';cp.execSync(`cd android && ${gradlew} --stop`,{stdio:'inherit',shell:true});\" && pnpm apk:release"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.7",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-firebase/app": "^19.0.0",
    "@react-native-firebase/auth": "^19.0.0",
    "@react-native-firebase/firestore": "^19.0.0",
    "@react-native-firebase/messaging": "^19.0.0",
    "@react-native-firebase/storage": "^19.0.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "react": "18.2.0",
    "react-native": "0.73.2",
    "react-native-biometrics": "^3.0.1",
    "react-native-image-picker": "^7.1.0",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "4.5.0",
    "react-native-screens": "3.37.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-webview": "^13.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@react-native-community/cli-platform-android": "12.3.0",
    "@react-native/babel-preset": "0.73.19",
    "@react-native/codegen": "0.73.2",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/gradle-plugin": "0.73.4",
    "@react-native/metro-config": "0.73.3",
    "@react-native/typescript-config": "0.73.1",
    "@types/react": "^18.2.48",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "metro-runtime": "0.80.12",
    "nullthrows": "1.1.1",
    "patch-package": "^8.0.0",
    "prettier": "3.2.4",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}